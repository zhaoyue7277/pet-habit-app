<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.kids.habit.pet_habit">

    <!-- ================= 权限声明 ================= -->
    <!-- 震动反馈（打卡 / 兑换成功的触觉反馈） -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
      录音权限（朗读打卡）：用户点击「开始录音」时由系统弹窗实时征询，
      用户拒绝则录音功能不可用，其余功能不受影响。
      录音数据仅写入本机 Hive，任何时刻都不会外传。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!--
      网络权限（3D 宠物渲染必需，但**不会产生任何真实外网流量**）。

      为什么必须加：
        3D 宠物用 InAppWebView + WebViewAssetLoader 渲染，页面地址是
            https://appassets.androidplatform.net/assets/flutter_assets/assets/3d/viewer.html
        这是 Android 官方的「虚拟域名」方案 —— 请求会被本地拦截、直接从 APK
        内 assets 读文件。但 Android WebView 对 https:// 请求会**先做权限检查**：
        缺少 INTERNET 权限时，请求在网络栈层面就被拒绝，
        WebViewClient.shouldInterceptRequest 根本不会被调用，
        页面永远加载不出来（v1.2.3 真机「模型加载超时」的根因之一）。

      隐私说明：
        唯一使用网络的组件是上面这个 WebView，且它请求的
        appassets.androidplatform.net 是系统保留域名，不解析到任何真实服务器，
        请求 100% 由 App 本地拦截。用户数据、录音、习惯记录依然全部只存本机
        （Hive / IndexedDB），任何时刻都不会外传。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      说明：番茄钟不依赖后台保活（约束 6 采用「切出 App 即暂停计时」方案），
      因此不需要任何前台服务权限。
    -->

    <application
        android:label="小宠习惯"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
